    "/.htaccess": [["AWSManagedRulesLinuxRuleSet", "LFI_URIPATH"]],
    "/.ssh/id_rsa": [["AWSManagedRulesLinuxRuleSet", "LFI_URIPATH"]],
    "/.aws/credentials": [["AWSManagedRulesCommonRuleSet", "GenericLFI_URIPATH"]],
    "/.aws/config": [["AWSManagedRulesKnownBadInputsRuleSet", "ExploitablePaths_URIPATH"]],
    "/config.bak": [["AWSManagedRulesCommonRuleSet", "RestrictedExtensions_URIPATH"]],
    "/.DS_Store": [],
    "/.svn/entries": [],
